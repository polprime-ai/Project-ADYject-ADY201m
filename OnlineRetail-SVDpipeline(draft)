    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "file_path='/kaggle/input/datasets/polprime/svdload/OnlineRetail_Clean.xlsx'\n",
    "\n",
    "df=pd.read_excel(file_path)\n",
    "\n",
    "df=df.dropna(subset=['CustomerID'])\n",
    "df=df[df['Quantity']>0]\n",
    "\n",
    "print(f'Shape sau khi lọc: {df.shape}')\n",
    "print(f'Unique customers : {df[\"CustomerID\"].nunique():,}')\n",
    "print(f'Unique products  : {df[\"StockCode\"].nunique():,}')\n",
    "\n",
    "# ════════════════════════════════════════════════════════\n",
    "# BƯỚC 2: SPARSITY ANALYSIS\n",
    "# Mục đích: Chứng minh định lượng tại sao cần SVD\n",
    "# (KNN hoạt động kém khi ma trận quá thưa)\n",
    "# ════════════════════════════════════════════════════════\n",
    "\n",
    "# Tạo user-item matrix tạm để đo sparsity\n",
    "# interaction_score = log1p(Quantity × UnitPrice)\n",
    "# → log1p giúp nén outlier (đơn 1000 sp không át đơn 10 sp)\n",
    "df['interaction_score']=np.log1p(df['Quantity']*df['UnitPrice'])\n",
    "\n",
    "user_item_matrix=df.pivot_table(\n",
    "    index='CustomerID',\n",
    "    columns='StockCode',\n",
    "    values='interaction_score',\n",
    "    aggfunc='sum',\n",
    "    fill_value=0\n",
    ")\n",
    "\n",
    "# Đếm số cặp (user, item) thực sự có tương tác\n",
    "n_users, n_items=user_item_matrix.shape\n",
    "total_cells=n_users*n_items\n",
    "n_interactions=df.groupby(['CustomerID', 'StockCode']).ngroups\n",
    "non_zero_in_matrix=int((user_item_matrix>0).sum().sum())\n",
    "\n",
    "# Kiểm tra tính nhất quán giữa df và matrix\n",
    "assert n_interactions == non_zero_in_matrix, (\n",
    "    f'Mismatch! groupby={n_interactions:,} | matrix non-zero={non_zero_in_matrix:,}'\n",
    ")\n",
    "\n",
    "density= n_interactions/total_cells\n",
    "sparsity=1- density\n",
    "\n",
    "print('=' * 52)\n",
    "print('SPARSITY REPORT — Online Retail')\n",
    "print('=' * 52)\n",
    "print(f'  Unique users: {n_users:>8,}')\n",
    "print(f'  Unique items: {n_items:>8,}')\n",
    "print(f'  Total cells: {total_cells:>8,}')\n",
    "print(f'  Non-zero interactions: {n_interactions:>8,}')\n",
    "print(f'  Density: {density:>8.4%}')\n",
    "print(f'  Sparsity: {sparsity:>8.4%}')\n",
    "print('=' * 52)\n",
    "\n",
    "# Nhận xét tự động dựa trên ngưỡng thực tế\n",
    "if sparsity >= 0.99:\n",
    "    print('⚠️  Sparsity ≥99% → SVD là lựa chọn phù hợp nhất.')\n",
    "elif sparsity >= 0.95:\n",
    "    print('⚠️  Sparsity 95–99% → Theo dõi sát hiệu năng KNN.')\n",
    "else:\n",
    "    print('✅  Sparsity ở mức chấp nhận được.')\n",
    "\n",
    "# Gom nhóm: 1 user mua 1 sản phẩm nhiều lần → tính tổng doanh thu\n",
    "svd_df=(\n",
    "    df.groupby(['CustomerID', 'StockCode'])['interaction_score']\n",
    "    .sum()\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# ════════════════════════════════════════════════════════\n",
    "# BƯỚC 3: CHUẨN BỊ DỮ LIỆU CHO SVD\n",
    "# Thư viện Surprise yêu cầu cấu trúc [User, Item, Rating]\n",
    "# với rating trong thang 1–5\n",
    "# ════════════════════════════════════════════════════════\n",
    "\n",
    "# Chỉ giữ interaction dương (tránh log1p(0) nếu có)\n",
    "svd_df=svd_df[svd_df['interaction_score']>0]\n",
    "\n",
    "# Chuẩn hóa Min-Max về thang [1, 5]\n",
    "# Lý do: Surprise mặc định kỳ vọng rating trong [1,5]\n",
    "# Nếu không chuẩn hóa, RMSE và MAE sẽ bị lệch scale\n",
    "mn=svd_df['interaction_score'].min()\n",
    "mx=svd_df['interaction_score'].max()\n",
    "svd_df['rating_normalized']=1+4*(svd_df['interaction_score']-mn)/(mx-mn)\n",
    "\n",
    "# Cấu trúc cuối cùng gồm đúng 3 cột mà Surprise Reader cần\n",
    "svd_data=svd_df[['CustomerID', 'StockCode', 'rating_normalized']]\n",
    "\n",
    "print(f'\\nSVD dataset shape : {svd_data.shape}')\n",
    "print(f'Rating range      : [{svd_data[\"rating_normalized\"].min():.2f}, '\n",
    "      f'{svd_data[\"rating_normalized\"].max():.2f}]')\n",
    "print(svd_data.describe().round(3))\n",
    "print(svd_data.head())\n",
    "\n",
    "# Xuất ra CSV để tuần 3 (train SVD) import trực tiếp, không cần xử lý lại\n",
    "svd_data.to_csv('svd_data_retail.csv', index=False)\n",
    "print('\\n✅ Đã xuất: svd_data_retail.csv')\n"
   ]
  }
