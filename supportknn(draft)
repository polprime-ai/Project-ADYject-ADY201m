sted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\n\ndef prepare_knn_dataset(file_path):\n    print(\"⏳ Đang chuẩn bị dữ liệu tối ưu riêng cho KNN của Quang Thái...\")\n    df = pd.read_excel(file_path)\n    df = df.dropna(subset=['CustomerID'])\n    \n    # Bước 1: Tính toán lượng tương tác ròng (Netting) để triệt tiêu nhiễu âm/dương\n    # Gom nhóm theo khách hàng và sản phẩm, tính tổng số lượng mua ròng\n    net_interactions = df.groupby(['CustomerID', 'StockCode'])['Quantity'].sum().reset_index()\n    \n    # Bước 2: Tạo ma trận Nhị phân (Binary) để giảm thiểu tối đa Sparsity cho KNN\n    # Nếu lượng mua ròng > 0, gán bằng 1 (Có tương tác chất lượng)\n    # Nếu lượng mua ròng <= 0 (đã hủy hết hoặc lỗi), ta loại bỏ vì không đem lại tín hiệu sở thích\n    knn_ready = net_interactions[net_interactions['Quantity'] > 0].copy()\n    knn_ready['interacted'] = 1\n    \n    final_knn_data = knn_ready[['CustomerID', 'StockCode', 'interacted']]\n    \n    # Tính toán độ thưa để kiểm tra xem đã giúp được Thái chưa\n    n_users = final_knn_data['CustomerID'].nunique()\n    n_items = final_knn_data['StockCode'].nunique()\n    sparsity = (1 - len(final_knn_data) / (n_users * n_items)) * 100\n    \n    print(f\"✅ Đã xử lý xong dữ liệu cho KNN!\")\n    print(f\"📊 Thống kê cho Thái: Số Users: {n_users} | Số Items: {n_items}\")\n    print(f\"📉 Độ thưa (Sparsity) của ma trận KNN: {sparsity:.2f}% (Đã được tối ưu bằng ma trận nhị phân)\")\n    \n    return final_knn_data\n\nfile_path='/kaggle/input/datasets/polprime/supportknndraft/OnlineRetail_Clean.xlsx'\nknn_data=prepare_knn_dataset(file_path)\nprint(knn_data.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-27T09:01:10.580679Z","iopub.execute_input":"2026-05-27T09:01:10.581003Z","iopub.status.idle":"2026-05-27T09:01:45.630413Z","shell.execute_reply.started":"2026-05-27T09:01:10.580974Z","shell.execute_reply":"2026-05-27T09:01:45.62933